# Copie este arquivo para ".env" e preencha os valores antes de rodar o servidor.

# Porta em que o servidor HTTP sobe localmente (a hospedagem em produção geralmente define isso sozinha).
PORT=3000

# "development" ou "production". Em produção, o cookie de sessão só é aceito via HTTPS.
NODE_ENV=development

# Connection string do Postgres (Neon, Supabase, Railway, RDS, etc.), formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=coloque_aqui_a_connection_string_do_seu_postgres

# Chave usada para criptografar CPF/RG em repouso (AES-256-GCM).
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Precisa ter exatamente 64 caracteres hexadecimais (32 bytes). NÃO reaproveite a chave de exemplo abaixo.
ENCRYPTION_KEY=coloque_aqui_64_caracteres_hexadecimais_gerados_com_o_comando_acima

# Nome do cookie de sessão do Badu.
SESSION_COOKIE_NAME=badu_session

# Segredo usado para derivar tokens de sessão. Também deve ser único e secreto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=coloque_aqui_outro_valor_aleatorio_e_secreto

# Origem do frontend, usada para configurar CORS caso o front seja hospedado separadamente do backend.
# Deixe em branco se o próprio backend está servindo os arquivos estáticos (index.html/css/js) — é o padrão deste projeto.
FRONTEND_ORIGIN=

# ---------------------------------------------------------------------------
# Dados do CONTRATADO que aparecem no texto do contrato e no PDF (não são
# segredos de sistema — são as mesmas informações que já aparecem em todo
# contrato assinado — mas ficam aqui, fora do código-fonte, por serem dados
# reais de CNPJ/endereço/pagamento de uma pessoa física ou empresa).
# ---------------------------------------------------------------------------
BUSINESS_NOME_ARTISTA=
BUSINESS_NOME_EMPRESA=
BUSINESS_CNPJ=
BUSINESS_REPRESENTANTE=
BUSINESS_END_RUA=
BUSINESS_END_NUMERO=
BUSINESS_END_BAIRRO=
BUSINESS_END_CEP=
BUSINESS_CIDADE_UF=
BUSINESS_PIX=
BUSINESS_BANCO_CONTA=
BUSINESS_BANCO_AGENCIA=
BUSINESS_BANCO_NOME=
